APP_NAME=ESIAYI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# LIVE, or DEMO to block all changes (template demo mode)
APP_MODE=LIVE

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=esiayi
DB_USERNAME=esiayi
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Outgoing mail is configured in Admin > Email Configuration; these are the fallback.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Generate with: php artisan jwt:secret (mobile app API tokens)
JWT_SECRET=

# Used once by `php artisan db:seed` to create the first admin on a fresh install.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Payment gateways, Pusher, analytics and social logins are configured in the admin panel.
